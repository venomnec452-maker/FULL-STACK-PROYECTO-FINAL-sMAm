# ==============================================================================
# StockMaster Full Stack - Variables de Entorno Globales (.env.example)
# Copiar este archivo a .env y ajustar según el entorno local o Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración General y Puertos de Acceso Local
# ------------------------------------------------------------------------------
APP_ENV=development

# Puertos expuestos en el host Windows
FRONTEND_PORT=3000
NODE_PORT=5001
LARAVEL_PORT=8000
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081

# ------------------------------------------------------------------------------
# 2. Base de Datos Principal: MongoDB (StockMaster Core)
# ------------------------------------------------------------------------------
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=stockmaster_db
# URI para conexión dentro de Docker (red interna)
MONGO_URI=mongodb://mongodb:27017/stockmaster_db
# URI para ejecución local de Node.js en Windows (fuera de contenedor)
MONGO_LOCAL_URI=mongodb://localhost:27017/stockmaster_db

# ------------------------------------------------------------------------------
# 3. Backend Principal: Node.js + Express
# ------------------------------------------------------------------------------
JWT_SECRET=stockmaster_jwt_secret_dev_key_academica_2026_xyz
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=stockmaster_refresh_jwt_secret_dev_key_academica_2026_xyz
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Clave compartida para comunicación segura Máquina-a-Máquina (M2M) entre Laravel y Node
INTERNAL_API_KEY=stockmaster_internal_secure_key_m2m_token_2026

# ------------------------------------------------------------------------------
# 4. Base de Datos Relacional: MySQL (Módulo de Compras Laravel)
# ------------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3308
MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_DATABASE=stockmaster_purchases
MYSQL_USER=stockmaster_user
MYSQL_PASSWORD=stockmaster_secure_password

# ------------------------------------------------------------------------------
# 5. Módulo Complementario: PHP / Laravel
# ------------------------------------------------------------------------------
LARAVEL_APP_NAME=StockMaster-Compras
LARAVEL_APP_ENV=local
LARAVEL_APP_KEY=base64:u3/2Bf0vJtGzLw3+Z+uLq1k7M4s9V0w1x2y3z4a5b6c=
LARAVEL_APP_DEBUG=true
LARAVEL_APP_URL=http://localhost:8000
# URL interna para que Laravel invoque a Node.js dentro de Docker
NODE_INTERNAL_API_URL=http://api:5000/api/v1

# ------------------------------------------------------------------------------
# 6. WordPress Headless y su Base de Datos MySQL dedicada
# ------------------------------------------------------------------------------
WP_DB_HOST=wordpress-db
WP_DB_PORT=3306
WP_DB_ROOT_PASSWORD=wp_root_secure_password
WP_DB_NAME=stockmaster_wp
WP_DB_USER=wp_user
WP_DB_PASSWORD=wp_secure_password
WORDPRESS_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 7. Frontend: Variables públicas para Vite (Cliente React)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
VITE_LARAVEL_API_URL=http://localhost:8000/api
VITE_WORDPRESS_API_URL=http://localhost:8080/wp-json/wp/v2
