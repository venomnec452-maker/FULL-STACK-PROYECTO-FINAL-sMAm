# ==============================================================================
# StockMaster Backend Node - Variables de Entorno Locales
# ==============================================================================
NODE_ENV=development
PORT=5000

# Conexión MongoDB (usar localhost si se corre en Windows fuera del contenedor)
MONGO_URI=mongodb://localhost:27017/stockmaster_db

# Seguridad JWT
JWT_SECRET=stockmaster_jwt_secret_dev_key_academica_2026_xyz
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=stockmaster_refresh_jwt_secret_dev_key_academica_2026_xyz
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Clave compartida para comunicación entre microservicios (Laravel <-> Node.js)
INTERNAL_API_KEY=stockmaster_internal_secure_key_m2m_token_2026
